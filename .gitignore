# Only the reviewed code, CI files and encrypted fixture material may be tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SOURCE-NOTICES.md
!/CI.md
!/REVISION.md
!/AGENTS.md
!/USER_RULE_DECISIONS.md

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml

!/.ci/
/.ci/*
!/.ci/fixtures.zip.enc
!/.ci/fixtures-manifest.json
!/.ci/source-snapshot.json
!/.ci/suites/
/.ci/suites/*
!/.ci/suites/*.json

!/examples/
/examples/*
!/examples/declared_skill_ranks.py

!/engine/
/engine/**
!/engine/**/
!/engine/**/*.py
!/tools/
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/ci_fixtures.mjs
!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/schema/
/schema/**
!/schema/**/
!/schema/**/*.json

!/work/
/work/*
!/work/reuse-partials/
/work/reuse-partials/*
!/work/reuse-partials/verify_overlay_tests.py

# Keep local/generated material excluded even inside an allowed code directory.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.log
*.zip
*.tmp
*.bak
*.lock
.env
.env.*
*credentials*
*.pem
*.key
id_rsa
id_ed25519
.aws/
.ssh/
.codex/
.agents/
Thumbs.db
.DS_Store

# Reviewed synthetic implementation-workflow tooling; no private inputs.
!/work/reuse-partials/acceptance_evidence.py
!/work/reuse-partials/reconcile_batch.py
!/work/reuse-partials/audit_vault_quality.py
!/work/reuse-partials/verify_ordered_core.py
!/work/reuse-partials/test_acceptance_capture.py
!/work/reuse-partials/test_reconcile_csv_core.py
!/work/reuse-partials/test_verify_ordered_publication.py
